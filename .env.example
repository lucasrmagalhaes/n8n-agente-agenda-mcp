# Copie para .env antes do primeiro `docker compose up` e troque a chave.
# O Compose lê este arquivo automaticamente para interpolar as variáveis.
# Não commite o .env.

# Fuso usado pelo n8n ($now) e pelo container. O system message também fixa America/Sao_Paulo.
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
# A URL de produção do MCP Server Trigger é montada a partir daqui.
# No n8n 2.30+ vale N8N_WEBHOOK_URL; WEBHOOK_URL cobre versões anteriores.
N8N_WEBHOOK_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/

# Gere com: openssl rand -hex 32
# Defina ANTES de criar credenciais. Trocar depois invalida o que já foi salvo.
N8N_ENCRYPTION_KEY=troque-esta-chave-antes-de-criar-credenciais

# A chave do Gemini NÃO entra no container. Cole na credencial "Google Gemini(PaLM) Api" da interface.
# Crie em https://aistudio.google.com/apikey sem ativar faturamento.
GEMINI_API_KEY=

# ID do calendário (em geral o seu Gmail). Substitua o placeholder dentro do workflow.
GOOGLE_CALENDAR_ID=COLOQUE_SEU_EMAIL@gmail.com

# Ollama só é necessário na alternativa local. De dentro da rede do Compose o host é o nome do serviço.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# URLs de produção já gravadas nos workflows (MCP Server Trigger v2, sem sufixo /sse).
MCP_PRODUCTION_URL=http://localhost:5678/mcp/agenda
MCP_PRODUCTION_URL_OLLAMA=http://localhost:5678/mcp/agenda-ollama
